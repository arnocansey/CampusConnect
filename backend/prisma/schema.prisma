generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  studentId       String?
  fullName        String
  phoneNumber     String?
  passwordHash    String
  profilePicture  String?
  coverPhoto      String?
  coverGradient   String?
  bio             String?
  department      String?
  program         String?
  level           Int?
  skills          String[]
  interests       String[]
  socialLinks     Json?
  role            UserRole  @default(STUDENT)
  isVerified      Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  isBanned        Boolean   @default(false)
  isPrivate       Boolean   @default(false)
  verificationToken String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  refreshToken    String?
  fcmToken        String?
  universityId    String?
  university      University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  lastSeen        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts           Post[]
  comments        Comment[]
  likes           Like[]
  savedPosts      SavedPost[]
  stories         Story[]
  followers       Follow[] @relation("following")
  following       Follow[] @relation("followers")
  messages        Message[]
  groupMembers    GroupMember[]
  groupMessages   GroupMessage[]
  marketplaceItems MarketplaceItem[]
  marketplaceReviews MarketplaceReview[] @relation("reviewer")
  sellerReviews   MarketplaceReview[] @relation("seller")
  notes           Note[]
  noteDownloads   NoteDownload[]
  noteBookmarks   NoteBookmark[]
  noteRatings     NoteRating[]
  jobApplications JobApplication[]
  eventRegistrations EventRegistration[]
  notifications   Notification[]
  hostelReviews   HostelReview[]
  reports         Report[]        @relation("reporter")
  reportedContent Report[]        @relation("reportedContent")
  adminActions    AdminAction[]
  commentLikes    CommentLike[]
  conversationMembers ConversationMember[]
  noteComments    NoteComment[]
  createdGroups   StudyGroup[]
  organizedEvents Event[]
  messageReactions MessageReaction[]
  pollVotes       PollVote[]
  securityLogs    SecurityLog[]
  auditLogs       AuditLog[]
  sessions        ActiveSession[]
  announcements   Announcement[]
  reposts         Repost[]
  blockedUsers    Block[]       @relation("blocker")
  blockedBy       Block[]       @relation("blocked")
  mutedUsers      Mute[]        @relation("muter")
  mutedBy         Mute[]        @relation("muted")
  profileViews    ProfileView[] @relation("viewedProfile")
  viewedProfiles  ProfileView[] @relation("profileViewer")
  mentions        Mention[]     @relation("mentionedUser")
  mentionedIn     Mention[]     @relation("mentionAuthor")
  subscriptions   UserSubscription[]
  payments        Payment[]
  isPremiumSeller Boolean   @default(false)
  premiumExpiry   DateTime?
  hasStore        Boolean   @default(false)
  storeName       String?
  storeDescription String?
  storeCreatedAt  DateTime?
  savedItems      SavedItem[]
  notePurchases   NotePurchase[]
  eventTickets    EventTicket[]
  hostelBookings  HostelBooking[]
  bannerAds       BannerAd[]

  @@index([email])
  @@index([username])
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

// ==================== SOCIAL FEED ====================

model Post {
  id          String    @id @default(uuid())
  content     String?
  images      String[]
  videoUrl    String?
  documentUrl String?
  location    String?
  type        PostType  @default(TEXT)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Like[]
  comments    Comment[]
  savedPosts  SavedPost[]
  tags        String[]
  poll        Poll?
  reposts     Repost[]
  mentions    Mention[]
  viewCount   Int       @default(0)
  shareCount  Int       @default(0)
  isEdited    Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([type])
}

model Poll {
  id        String       @id @default(uuid())
  postId    String       @unique
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
  expiresAt DateTime?
  createdAt DateTime     @default(now())
}

model PollOption {
  id      String     @id @default(uuid())
  pollId  String
  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text    String
  votes   PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  pollId   String
  optionId String
  userId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  POLL
  MARKETPLACE
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  images    String[]
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Story {
  id              String      @id @default(uuid())
  imageUrl        String?
  backgroundColor String?
  content         String?
  authorId        String
  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views           StoryView[]
  expiresAt       DateTime
  createdAt       DateTime    @default(now())

  @@index([authorId])
  @@index([expiresAt])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id          String   @id @default(uuid())
  blockerId   String
  blocker     User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Mute {
  id          String   @id @default(uuid())
  muterId     String
  muter       User     @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId     String
  muted       User     @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

model Repost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model ProfileView {
  id          String   @id @default(uuid())
  viewerId    String
  viewer      User     @relation("profileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId    String
  viewed      User     @relation("viewedProfile", fields: [viewedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId])
}

model Mention {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("mentionedUser", fields: [userId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("mentionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ==================== MESSAGING ====================

model Conversation {
  id          String         @id @default(uuid())
  isGroup     Boolean        @default(false)
  name        String?
  avatar      String?
  messages    Message[]
  members     ConversationMember[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  content        String?
  imageUrl       String?
  fileUrl        String?
  type           MessageType  @default(TEXT)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readBy         MessageRead[]
  reactions      MessageReaction[]
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

// ==================== MARKETPLACE ====================

model MarketplaceItem {
  id              String   @id @default(uuid())
  title           String
  description     String
  images          String[]
  price           Float
  currency        String   @default("GHS")
  category        MarketplaceCategory
  condition       ItemCondition @default(USED)
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  isAvailable     Boolean  @default(true)
  isSold          Boolean  @default(false)
  isApproved      Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  featuredAt      DateTime?
  featuredExpiry  DateTime?
  location        String?
  reviews         MarketplaceReview[]
  savedBy         SavedItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sellerId])
  @@index([category])
  @@index([createdAt])
  @@index([isFeatured])
}

enum MarketplaceCategory {
  BOOKS
  ELECTRONICS
  CLOTHING
  ACCESSORIES
  SERVICES
  HOSTEL_ITEMS
  OTHER
}

enum ItemCondition {
  NEW
  LIKE_NEW
  USED
  FAIR
}

model MarketplaceReview {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  reviewerId String
  reviewer  User     @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemId    String
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewerId, itemId])
}

// ==================== NOTES HUB ====================

model Note {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileType    NoteFileType
  course      String
  department  String
  level       Int
  semester    String?
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  downloads   NoteDownload[]
  bookmarks   NoteBookmark[]
  ratings     NoteRating[]
  comments    NoteComment[]
  purchases   NotePurchase[]
  tags        String[]
  isApproved  Boolean  @default(false)
  isRejected  Boolean  @default(false)
  isPaid      Boolean  @default(false)
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uploaderId])
  @@index([course])
  @@index([department])
  @@index([level])
}

enum NoteFileType {
  PDF
  DOCX
  PPT
  ZIP
  OTHER
}

model NoteDownload {
  id       String @id @default(uuid())
  noteId   String
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloadedAt DateTime @default(now())

  @@unique([noteId, userId])
}

model NoteBookmark {
  id       String @id @default(uuid())
  noteId   String
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
}

model NoteRating {
  id        String @id @default(uuid())
  noteId    String
  note      Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
}

model NoteComment {
  id        String   @id @default(uuid())
  content   String
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([noteId])
}

// ==================== STUDY GROUPS ====================

model StudyGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatar      String?
  course      String?
  department  String?
  level       Int?
  isPublic    Boolean  @default(true)
  maxMembers  Int      @default(50)
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]
  files       GroupFile[]
  events      GroupEvent[]
  announcements GroupAnnouncement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([course])
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

enum GroupRole {
  MEMBER
  MODERATOR
  ADMIN
}

model GroupMessage {
  id        String   @id @default(uuid())
  content   String
  imageUrl  String?
  fileUrl   String?
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([groupId])
}

model GroupFile {
  id        String   @id @default(uuid())
  name      String
  url       String
  size      Int
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploaderId String
  uploadedAt DateTime @default(now())
}

model GroupEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  location    String?
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model GroupAnnouncement {
  id        String   @id @default(uuid())
  content   String
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
}

// ==================== HOSTEL FINDER ====================

model Hostel {
  id          String   @id @default(uuid())
  name        String
  description String
  images      String[]
  location    String
  latitude    Float?
  longitude   Float?
  pricePerMonth Float
  currency    String   @default("GHS")
  roomType    RoomType
  facilities  String[]
  contactPhone String?
  contactEmail String?
  isApproved   Boolean  @default(false)
  reviews     HostelReview[]
  bookings    HostelBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([location])
  @@index([roomType])
  @@index([pricePerMonth])
}

enum RoomType {
  SINGLE
  SHARED
  SELF_CONTAINED
}

model HostelReview {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  hostelId  String
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hostelId])
}

// ==================== JOBS & INTERNSHIPS ====================

model Job {
  id          String   @id @default(uuid())
  title       String
  company     String
  description String
  requirements String[]
  salary      String?
  jobType     JobType
  location    String?
  isRemote    Boolean  @default(false)
  deadline    DateTime?
  applicationUrl String?
  contactEmail String?
  isApproved   Boolean  @default(false)
  applications JobApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobType])
  @@index([createdAt])
}

enum JobType {
  PART_TIME
  FULL_TIME
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeUrl String?
  coverLetter String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, userId])
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

// ==================== EVENTS ====================

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  venue       String
  date        DateTime
  endTime     DateTime?
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  category    EventCategory @default(ACADEMIC)
  maxAttendees Int?
  isApproved   Boolean  @default(false)
  isFree       Boolean  @default(true)
  ticketPrice  Float    @default(0)
  registrations EventRegistration[]
  tickets     EventTicket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

enum EventCategory {
  ACADEMIC
  SOCIAL
  SPORTS
  CULTURAL
  TECH
  CAREER
  OTHER
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCode String  @default(uuid())
  checkedIn Boolean  @default(false)
  checkedInAt DateTime?
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  type      NotificationType
  content   String
  link      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MESSAGE
  EVENT
  MARKETPLACE
  GROUP
  SYSTEM
  MENTION
}

// ==================== REPORTS & MODERATION ====================

model Report {
  id           String   @id @default(uuid())
  reason       ReportReason
  description  String?
  contentType  ReportContentType
  contentId    String
  reporterId   String
  reporter     User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser User?    @relation("reportedContent", fields: [reportedUserId], references: [id])
  status       ReportStatus @default(PENDING)
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([contentType])
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  OTHER
}

enum ReportContentType {
  POST
  COMMENT
  USER
  MESSAGE
  MARKETPLACE_ITEM
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model AdminAction {
  id        String   @id @default(uuid())
  action    AdminActionType
  targetType String
  targetId  String
  reason    String?
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum AdminActionType {
  WARN
  SUSPEND
  BAN
  DELETE_CONTENT
  RESTORE_CONTENT
}

// ==================== UNIVERSITY ====================

model University {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String
  logo        String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    User[]

  @@index([name])
}

// ==================== SECURITY & AUDIT ====================

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ip        String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String          @id @default(uuid())
  adminId   String
  admin     User            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    AuditActionType
  target    String
  details   String?
  ipAddress String?
  createdAt DateTime        @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model ActiveSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String
  device     String
  browser    String
  lastActive DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

enum AuditActionType {
  USER_BAN
  USER_UNBAN
  USER_ROLE_CHANGE
  POST_DELETE
  COMMENT_DELETE
  GROUP_DELETE
  SETTINGS_CHANGE
  ANNOUNCEMENT_CREATE
  ANNOUNCEMENT_DELETE
  REPORT_RESOLVE
  REPORT_DISMISS
  SECURITY_ACTION
}

// ==================== ANNOUNCEMENTS ====================

model Announcement {
  id          String            @id @default(uuid())
  title       String
  message     String
  type        AnnouncementType  @default(ALL)
  targeting   String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([createdById])
}

enum AnnouncementType {
  ALL
  UNIVERSITY
  DEPARTMENT
  ROLE
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discount    Float
  discountType DiscountType @default(PERCENTAGE)
  maxUses     Int?
  usedCount   Int      @default(0)
  minPurchase Float?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

model Promotion {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  discount    Float
  discountType DiscountType @default(PERCENTAGE)
  category    MarketplaceCategory?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ==================== SUBSCRIPTIONS & PAYMENTS ====================

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  currency    String   @default("GHS")
  adLimit     Int      // -1 = unlimited
  durationDays Int     // how many days the subscription lasts
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserSubscription[]
  payments      Payment[]

  @@index([isActive])
}

model UserSubscription {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  adsRemaining  Int      // -1 = unlimited
  adsUsed       Int      @default(0)
  startDate     DateTime @default(now())
  expiresAt     DateTime
  status        SubscriptionStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  amount          Float
  currency        String   @default("GHS")
  reference       String   @unique // Paystack reference
  status          PaymentStatus @default(PENDING)
  paystackResponse Json?
  subscriptionId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([reference])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==================== FEATURED LISTINGS ====================

// isFeatured, featuredAt, featuredExpiry fields added to MarketplaceItem above

// ==================== BANNER ADS ====================

model BannerAd {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  linkUrl     String?
  position    BannerPosition @default(SIDEBAR)
  isActive    Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  advertiserId String?
  advertiser  User?    @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, position])
  @@index([startDate, endDate])
}

enum BannerPosition {
  SIDEBAR
  FEED_TOP
  FEED_MIDDLE
  MARKETPLACE_TOP
}

// ==================== PREMIUM PROFILES ====================

// isPremiumSeller, premiumExpiry fields added to User above

// ==================== NOTES MARKETPLACE ====================

model NotePurchase {
  id              String   @id @default(uuid())
  noteId          String
  note            Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount          Float
  platformFee     Float
  uploaderEarning Float
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime @default(now())

  @@unique([noteId, buyerId])
  @@index([noteId])
  @@index([buyerId])
}

// ==================== EVENT TICKETING ====================

model EventTicket {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  totalAmount     Float
  platformFee     Float
  organizerEarning Float
  status          PaymentStatus @default(PENDING)
  ticketCode      String   @default(uuid())
  checkedIn       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([eventId])
  @@index([buyerId])
}

// ==================== HOSTEL BOOKINGS ====================

model HostelBooking {
  id                String   @id @default(uuid())
  hostelId          String
  hostel            Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkIn           DateTime
  checkOut          DateTime
  monthlyRent       Float
  platformCommission Float
  status            BookingStatus @default(PENDING)
  contactPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([hostelId])
  @@index([studentId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ==================== SAVED ITEMS (for marketplace) ====================

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}
